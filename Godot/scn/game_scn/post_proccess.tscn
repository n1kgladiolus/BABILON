[gd_scene format=3 uid="uid://dijhyad7qskt5"]

[sub_resource type="GDScript" id="GDScript_bv0ed"]
script/source = "extends CanvasLayer
var material

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	material = $ColorRect.material as ShaderMaterial
	open()


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass

func open():
	if material:
		_tween_shader_param(\"outer_radius\", 3.0, 5)

func lock():
	if material:
		_tween_shader_param(\"outer_radius\", 0.0, 5)


func _tween_shader_param(param: String, target: float, duration: float) -> void:
	var current: float = material.get_shader_parameter(param)
	var tween := create_tween()
	tween.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tween.tween_method(
		func(v: float) -> void: material.set_shader_parameter(param, v),
		current,
		target,
		duration
	)
"

[sub_resource type="Shader" id="Shader_oks1d"]
code = "shader_type canvas_item;

uniform float outer_radius : hint_range(0.0, 5.0) = 0.3;
uniform float intensity : hint_range(0.0, 1.0) = 0.25;
uniform vec4 vignette_color : source_color = vec4(0.0, 0.0, 0.0, 1.0);

void fragment() {
    // Расстояние от центра, нормализованное (0 в центре, ~1.4 в углу)
    float x = abs(UV.x - 0.5) * 0.1;
    float y = abs(UV.y - 0.5) * 1.0;
    float dist = sqrt(x*x + y*y) / outer_radius;
    
    COLOR = vec4(vignette_color.rgb, dist * intensity);
}"

