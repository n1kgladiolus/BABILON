; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Vavilon"
config/description="Дипломатическая стратегия Вавилон. Онлайн версия. Создано NKA & AleSanLab"
config/version="1.0.0"
run/main_scene="uid://djrjhokj4nanr"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=120
boot_splash/bg_color=Color(0.039215688, 0.039215688, 0.039215688, 1)
boot_splash/stretch_mode=0
boot_splash/image="uid://bdp3tqdf3s3w6"
config/icon="uid://bupnuvn0enm1x"

[audio]

buses/default_bus_layout="uid://dia03nmhevr2l"
driver/enable_input=true
driver/mix_rate=48000

[autoload]

R="*uid://vuecay86dk6b"
LimboConsole="*uid://dyxornv8vwibg"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_local_constant=0
gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/instance_log/plugin.cfg", "res://addons/limbo_console/plugin.cfg", "res://addons/script_splitter/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "teal",
"res://image/": "red",
"res://import/": "gray",
"res://object/": "yellow",
"res://scn/": "pink",
"res://scr/": "green",
"res://sound/": "orange",
"res://tools/": "gray",
"res://visual/": "purple"
}

[gui]

theme/custom="uid://3u1sptp2eqeb"
theme/custom_font="uid://bpgt21ocxmms4"

